{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.medsup.example/v1/contracts.schema.json",
  "title": "MedsUp provider-neutral API contracts v1",
  "$defs": {
    "EphemeralDocumentInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "schemaVersion", "reviewSessionId", "mediaType", "byteLength"],
      "properties": {
        "apiVersion": { "const": "v1" },
        "schemaVersion": { "const": 1 },
        "reviewSessionId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$" },
        "mediaType": { "enum": ["application/pdf", "image/jpeg", "image/png"] },
        "byteLength": { "type": "integer", "minimum": 1 }
      }
    },
    "UntrustedPrescriptionProposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "schemaVersion", "lifecycle", "reviewSessionId", "generatedAt", "expiresAt", "clinicalContent"],
      "properties": {
        "apiVersion": { "const": "v1" },
        "schemaVersion": { "const": 1 },
        "lifecycle": { "const": "SESSION_ONLY_UNTRUSTED" },
        "reviewSessionId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$" },
        "generatedAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "clinicalContent": { "$ref": "#/$defs/PrescriptionVersion/properties/clinicalContent" }
      }
    },
    "DoctorConfirmationCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "schemaVersion", "idempotencyKey", "reviewSessionId", "ownerDoctorId", "confirmation", "correctedClinicalContent"],
      "properties": {
        "apiVersion": { "const": "v1" },
        "schemaVersion": { "const": 1 },
        "idempotencyKey": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{16,128}$" },
        "reviewSessionId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$" },
        "ownerDoctorId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$" },
        "confirmation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["decision", "confirmedByDoctorId", "confirmedAt"],
          "properties": {
            "decision": { "const": "CONFIRMED" },
            "confirmedByDoctorId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$" },
            "confirmedAt": { "type": "string", "format": "date-time" }
          }
        },
        "correctedClinicalContent": { "$ref": "#/$defs/PrescriptionVersion/properties/clinicalContent" }
      }
    },
    "ConfirmedPrescription": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "schemaVersion", "lifecycle", "prescriptionId", "ownerDoctorId", "patientAssociationId", "status", "currentPrescriptionVersion", "resourceVersion", "createdAt", "updatedAt"],
      "properties": {
        "apiVersion": { "const": "v1" },
        "schemaVersion": { "const": 1 },
        "lifecycle": { "const": "DOCTOR_CONFIRMED" },
        "prescriptionId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$" },
        "ownerDoctorId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$" },
        "patientAssociationId": { "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$" }] },
        "status": { "enum": ["ACTIVE", "SUSPENDED", "CANCELLED"] },
        "currentPrescriptionVersion": { "type": "integer", "minimum": 1 },
        "resourceVersion": { "type": "integer", "minimum": 1 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "PrescriptionVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "schemaVersion", "lifecycle", "prescriptionId", "prescriptionVersion", "resourceVersion", "confirmedByDoctorId", "confirmedAt", "createdAt", "clinicalContent"],
      "properties": {
        "apiVersion": { "const": "v1" },
        "schemaVersion": { "const": 1 },
        "lifecycle": { "const": "DOCTOR_CONFIRMED_VERSION" },
        "prescriptionId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$" },
        "prescriptionVersion": { "type": "integer", "minimum": 1 },
        "resourceVersion": { "type": "integer", "minimum": 1 },
        "confirmedByDoctorId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$" },
        "confirmedAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "clinicalContent": {
          "type": "object",
          "additionalProperties": false,
          "required": ["medications"],
          "properties": {
            "medications": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["medicationName", "dose"],
                "properties": {
                  "medicationName": { "type": "string", "minLength": 1 },
                  "dose": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        }
      }
    },
    "PrescriptionStatusCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "schemaVersion", "idempotencyKey", "prescriptionId", "ownerDoctorId", "expectedResourceVersion", "targetStatus", "requestedAt"],
      "properties": {
        "apiVersion": { "const": "v1" },
        "schemaVersion": { "const": 1 },
        "idempotencyKey": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{16,128}$" },
        "prescriptionId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$" },
        "ownerDoctorId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$" },
        "expectedResourceVersion": { "type": "integer", "minimum": 1 },
        "targetStatus": { "enum": ["SUSPENDED", "CANCELLED"] },
        "requestedAt": { "type": "string", "format": "date-time" }
      }
    },
    "PrescriptionStatusEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "schemaVersion", "eventId", "prescriptionId", "prescriptionVersion", "previousStatus", "status", "resourceVersion", "serverVersion", "occurredAt"],
      "properties": {
        "apiVersion": { "const": "v1" },
        "schemaVersion": { "const": 1 },
        "eventId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$" },
        "prescriptionId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$" },
        "prescriptionVersion": { "type": "integer", "minimum": 1 },
        "previousStatus": { "enum": ["ACTIVE", "SUSPENDED"] },
        "status": { "enum": ["SUSPENDED", "CANCELLED"] },
        "resourceVersion": { "type": "integer", "minimum": 2 },
        "serverVersion": { "type": "integer", "minimum": 1 },
        "occurredAt": { "type": "string", "format": "date-time" }
      }
    },
    "AuditReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "schemaVersion", "auditReferenceId", "eventType", "outcome", "occurredAt", "securityCorrelationId"],
      "properties": {
        "apiVersion": { "const": "v1" },
        "schemaVersion": { "const": 1 },
        "auditReferenceId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$" },
        "eventType": { "enum": ["EPHEMERAL_EXTRACTION", "DOCTOR_CONFIRMATION", "PRESCRIPTION_STATUS_CHANGE"] },
        "outcome": { "enum": ["STARTED", "COMPLETED", "FAILED", "DENIED"] },
        "occurredAt": { "type": "string", "format": "date-time" },
        "securityCorrelationId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$" }
      }
    },
    "ErrorEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "error"],
      "properties": {
        "apiVersion": { "const": "v1" },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message", "requestId", "retryable"],
          "properties": {
            "code": { "enum": ["VALIDATION_FAILED", "UNAUTHORIZED", "NOT_FOUND", "CONFLICT", "STALE_RESOURCE_VERSION", "IDEMPOTENCY_CONFLICT", "UNSUPPORTED_API_VERSION", "INTERNAL_ERROR"] },
            "message": { "type": "string" },
            "requestId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$" },
            "retryable": { "type": "boolean" }
          }
        }
      }
    }
  }
}
