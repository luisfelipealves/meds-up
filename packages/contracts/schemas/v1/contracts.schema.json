{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.medsup.example/v1/contracts.schema.json",
  "title": "MedsUp provider-neutral API contracts v1",
  "$defs": {
    "EphemeralDocumentInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "schemaVersion", "reviewSessionId", "mediaType", "byteLength"],
      "properties": {
        "apiVersion": { "const": "v1" },
        "schemaVersion": { "const": 1 },
        "reviewSessionId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$" },
        "mediaType": { "enum": ["application/pdf", "image/jpeg", "image/png"] },
        "byteLength": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
      }
    },
    "UntrustedPrescriptionProposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "schemaVersion", "lifecycle", "reviewSessionId", "generatedAt", "expiresAt", "provenance", "confidence", "clinicalContent"],
      "properties": {
        "apiVersion": { "const": "v1" },
        "schemaVersion": { "const": 1 },
        "lifecycle": { "const": "SESSION_ONLY_UNTRUSTED" },
        "reviewSessionId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$" },
        "generatedAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "scope"],
          "properties": {
            "source": { "const": "OCR_AI_EXTRACTION" },
            "scope": { "const": "SESSION_ONLY" }
          }
        },
        "confidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["overall"],
          "properties": { "overall": { "type": "number", "minimum": 0, "maximum": 1 } }
        },
        "clinicalContent": { "$ref": "#/$defs/PrescriptionVersion/properties/clinicalContent" }
      }
    },
    "DoctorConfirmationCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "schemaVersion", "idempotencyKey", "reviewSessionId", "ownerDoctorId", "confirmation", "correctedClinicalContent"],
      "properties": {
        "apiVersion": { "const": "v1" },
        "schemaVersion": { "const": 1 },
        "idempotencyKey": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{16,128}$" },
        "reviewSessionId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$" },
        "ownerDoctorId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$" },
        "confirmation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["decision", "confirmedByDoctorId", "confirmedAt"],
          "properties": {
            "decision": { "const": "CONFIRMED" },
            "confirmedByDoctorId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$" },
            "confirmedAt": { "type": "string", "format": "date-time" }
          }
        },
        "correctedClinicalContent": { "$ref": "#/$defs/PrescriptionVersion/properties/clinicalContent" }
      }
    },
    "PrescriptionClinicalChangeCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "schemaVersion", "idempotencyKey", "prescriptionId", "ownerDoctorId", "expectedResourceVersion", "confirmation", "correctedClinicalContent"],
      "properties": {
        "apiVersion": { "const": "v1" },
        "schemaVersion": { "const": 1 },
        "idempotencyKey": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{16,128}$" },
        "prescriptionId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$" },
        "ownerDoctorId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$" },
        "expectedResourceVersion": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "confirmation": { "$ref": "#/$defs/DoctorConfirmationCommand/properties/confirmation" },
        "correctedClinicalContent": { "$ref": "#/$defs/PrescriptionVersion/properties/clinicalContent" }
      }
    },
    "ConfirmedPrescription": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "schemaVersion", "lifecycle", "prescriptionId", "ownerDoctorId", "patientAssociationId", "status", "currentPrescriptionVersion", "resourceVersion", "createdAt", "updatedAt"],
      "properties": {
        "apiVersion": { "const": "v1" },
        "schemaVersion": { "const": 1 },
        "lifecycle": { "const": "DOCTOR_CONFIRMED" },
        "prescriptionId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$" },
        "ownerDoctorId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$" },
        "patientAssociationId": { "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$" }] },
        "status": { "enum": ["ACTIVE", "SUSPENDED", "CANCELLED"] },
        "currentPrescriptionVersion": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "resourceVersion": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "PrescriptionVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "schemaVersion", "lifecycle", "prescriptionId", "prescriptionVersion", "resourceVersion", "confirmedByDoctorId", "confirmedAt", "createdAt", "clinicalContent"],
      "properties": {
        "apiVersion": { "const": "v1" },
        "schemaVersion": { "const": 1 },
        "lifecycle": { "const": "DOCTOR_CONFIRMED_VERSION" },
        "prescriptionId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$" },
        "prescriptionVersion": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "resourceVersion": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "confirmedByDoctorId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$" },
        "confirmedAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "clinicalContent": {
          "type": "object",
          "additionalProperties": false,
          "required": ["medications"],
          "properties": {
            "medications": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["medicationName", "dose"],
                "properties": {
                  "medicationName": { "type": "string", "minLength": 1, "pattern": "\\S" },
                  "dose": { "type": "string", "minLength": 1, "pattern": "\\S" }
                }
              }
            }
          }
        }
      }
    },
    "PrescriptionStatusCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "schemaVersion", "idempotencyKey", "prescriptionId", "ownerDoctorId", "expectedResourceVersion", "targetStatus", "requestedAt"],
      "properties": {
        "apiVersion": { "const": "v1" },
        "schemaVersion": { "const": 1 },
        "idempotencyKey": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{16,128}$" },
        "prescriptionId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$" },
        "ownerDoctorId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$" },
        "expectedResourceVersion": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "targetStatus": { "enum": ["SUSPENDED", "CANCELLED"] },
        "requestedAt": { "type": "string", "format": "date-time" }
      }
    },
    "PrescriptionStatusEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "schemaVersion", "eventId", "prescriptionId", "prescriptionVersion", "previousStatus", "status", "resourceVersion", "serverVersion", "occurredAt"],
      "properties": {
        "apiVersion": { "const": "v1" },
        "schemaVersion": { "const": 1 },
        "eventId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$" },
        "prescriptionId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$" },
        "prescriptionVersion": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "previousStatus": { "enum": ["ACTIVE", "SUSPENDED"] },
        "status": { "enum": ["SUSPENDED", "CANCELLED"] },
        "resourceVersion": { "type": "integer", "minimum": 2, "maximum": 9007199254740991 },
        "serverVersion": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "occurredAt": { "type": "string", "format": "date-time" }
      }
    },
    "AuditReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "schemaVersion", "auditReferenceId", "eventType", "outcome", "occurredAt", "securityCorrelationId"],
      "properties": {
        "apiVersion": { "const": "v1" },
        "schemaVersion": { "const": 1 },
        "auditReferenceId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$" },
        "eventType": { "enum": ["EPHEMERAL_EXTRACTION", "DOCTOR_CONFIRMATION", "PRESCRIPTION_CLINICAL_CHANGE", "PRESCRIPTION_STATUS_CHANGE"] },
        "outcome": { "enum": ["STARTED", "COMPLETED", "FAILED", "DENIED"] },
        "occurredAt": { "type": "string", "format": "date-time" },
        "securityCorrelationId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$" }
      }
    },
    "PrescriptionAuditRecord": {
      "type": "object", "additionalProperties": false,
      "required": ["apiVersion", "schemaVersion", "auditReferenceId", "eventType", "outcome", "actorDoctorId", "occurredAt", "securityCorrelationId", "prescriptionId", "prescriptionVersion", "previousPrescriptionVersion", "resourceVersion"],
      "properties": {
        "apiVersion": { "const": "v1" }, "schemaVersion": { "const": 1 },
        "auditReferenceId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$" },
        "eventType": { "enum": ["DOCTOR_CONFIRMATION", "PRESCRIPTION_CLINICAL_CHANGE", "PRESCRIPTION_STATUS_CHANGE"] },
        "outcome": { "const": "COMPLETED" },
        "actorDoctorId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$" },
        "occurredAt": { "type": "string", "format": "date-time" },
        "securityCorrelationId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$" },
        "prescriptionId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$" },
        "prescriptionVersion": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "previousPrescriptionVersion": { "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }] },
        "resourceVersion": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
      }
    },
    "ClaimIdentityPreview": {
      "type": "object", "additionalProperties": false,
      "required": ["apiVersion", "schemaVersion", "initials", "issuerDisplayName"],
      "properties": {
        "apiVersion": { "const": "v1" }, "schemaVersion": { "const": 1 },
        "initials": { "type": "string", "pattern": "^\\p{L}{1,2}$" },
        "issuerDisplayName": { "type": "string", "minLength": 1, "maxLength": 120, "pattern": "^(?!.*[\\u0000-\\u001F\\u007F\\u0080-\\u009F\\u00AD\\u0600-\\u0605\\u061C\\u06DD\\u070F\\u0890-\\u0891\\u08E2\\u180E\\u200B-\\u200F\\u2028\\u2029\\u202A-\\u202E\\u2060-\\u2064\\u2066-\\u206F\\uFEFF\\uFFF9-\\uFFFB]).*$" }
      }
    },
    "ClaimIdentityConfirmationCommand": {
      "type": "object", "additionalProperties": false,
      "required": ["apiVersion", "schemaVersion", "rawToken", "dateOfBirth"],
      "properties": {
        "apiVersion": { "const": "v1" }, "schemaVersion": { "const": 1 },
        "rawToken": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" },
        "dateOfBirth": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    },
    "ClaimIdentityAuditRecord": {
      "type": "object", "additionalProperties": false,
      "required": ["apiVersion", "schemaVersion", "claimAttemptId", "actorPatientSubjectId", "claimTokenId", "operation", "outcome", "occurredAt"],
      "properties": {
        "apiVersion": { "const": "v1" }, "schemaVersion": { "const": 1 },
        "claimAttemptId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$" },
        "actorPatientSubjectId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$" },
        "claimTokenId": { "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$" }] },
        "operation": { "enum": ["PREVIEW", "CONFIRM"] },
        "outcome": { "enum": ["PREVIEWED", "CONFIRMED", "INVALID_TOKEN", "DOB_MISMATCH", "RATE_LIMITED", "INTERNAL_ERROR"] },
        "occurredAt": { "type": "string", "format": "date-time" }
      }
    },
    "ErrorEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "error"],
      "properties": {
        "apiVersion": { "const": "v1" },
        "error": {
          "oneOf": [
            { "$ref": "#/$defs/ErrorEnvelope/$defs/VALIDATION_FAILED" },
            { "$ref": "#/$defs/ErrorEnvelope/$defs/UNAUTHORIZED" },
            { "$ref": "#/$defs/ErrorEnvelope/$defs/NOT_FOUND" },
            { "$ref": "#/$defs/ErrorEnvelope/$defs/CONFLICT" },
            { "$ref": "#/$defs/ErrorEnvelope/$defs/STALE_RESOURCE_VERSION" },
            { "$ref": "#/$defs/ErrorEnvelope/$defs/IDEMPOTENCY_CONFLICT" },
            { "$ref": "#/$defs/ErrorEnvelope/$defs/UNSUPPORTED_API_VERSION" },
            { "$ref": "#/$defs/ErrorEnvelope/$defs/AUTHENTICATION_FAILED" },
            { "$ref": "#/$defs/ErrorEnvelope/$defs/INVALID_AUTHENTICATED_SUBJECT" },
            { "$ref": "#/$defs/ErrorEnvelope/$defs/ROLE_FORBIDDEN" },
            { "$ref": "#/$defs/ErrorEnvelope/$defs/SESSION_EXPIRED" },
            { "$ref": "#/$defs/ErrorEnvelope/$defs/SESSION_REVOKED" },
            { "$ref": "#/$defs/ErrorEnvelope/$defs/DEVICE_REVOKED" },
            { "$ref": "#/$defs/ErrorEnvelope/$defs/CLAIM_IDENTITY_FAILED" },
            { "$ref": "#/$defs/ErrorEnvelope/$defs/INTERNAL_ERROR" }
          ]
        }
      },
      "$defs": {
        "VALIDATION_FAILED": {
          "type": "object", "additionalProperties": false, "required": ["code", "message", "requestId", "retryable"],
          "properties": { "code": { "const": "VALIDATION_FAILED" }, "message": { "const": "The request is invalid." }, "requestId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$" }, "retryable": { "const": false } }
        },
        "UNAUTHORIZED": {
          "type": "object", "additionalProperties": false, "required": ["code", "message", "requestId", "retryable"],
          "properties": { "code": { "const": "UNAUTHORIZED" }, "message": { "const": "The request is not authorized." }, "requestId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$" }, "retryable": { "const": false } }
        },
        "NOT_FOUND": {
          "type": "object", "additionalProperties": false, "required": ["code", "message", "requestId", "retryable"],
          "properties": { "code": { "const": "NOT_FOUND" }, "message": { "const": "The resource was not found." }, "requestId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$" }, "retryable": { "const": false } }
        },
        "CONFLICT": {
          "type": "object", "additionalProperties": false, "required": ["code", "message", "requestId", "retryable"],
          "properties": { "code": { "const": "CONFLICT" }, "message": { "const": "The request conflicts with the resource state." }, "requestId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$" }, "retryable": { "const": false } }
        },
        "STALE_RESOURCE_VERSION": {
          "type": "object", "additionalProperties": false, "required": ["code", "message", "requestId", "retryable"],
          "properties": { "code": { "const": "STALE_RESOURCE_VERSION" }, "message": { "const": "The resource changed; refresh and retry." }, "requestId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$" }, "retryable": { "const": true } }
        },
        "IDEMPOTENCY_CONFLICT": {
          "type": "object", "additionalProperties": false, "required": ["code", "message", "requestId", "retryable"],
          "properties": { "code": { "const": "IDEMPOTENCY_CONFLICT" }, "message": { "const": "The idempotency key was already used for another request." }, "requestId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$" }, "retryable": { "const": false } }
        },
        "UNSUPPORTED_API_VERSION": {
          "type": "object", "additionalProperties": false, "required": ["code", "message", "requestId", "retryable"],
          "properties": { "code": { "const": "UNSUPPORTED_API_VERSION" }, "message": { "const": "The API version is not supported." }, "requestId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$" }, "retryable": { "const": false } }
        },
        "AUTHENTICATION_FAILED": {
          "type": "object", "additionalProperties": false, "required": ["code", "message", "requestId", "retryable"],
          "properties": { "code": { "const": "AUTHENTICATION_FAILED" }, "message": { "const": "Authentication failed." }, "requestId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$" }, "retryable": { "const": false } }
        },
        "INVALID_AUTHENTICATED_SUBJECT": {
          "type": "object", "additionalProperties": false, "required": ["code", "message", "requestId", "retryable"],
          "properties": { "code": { "const": "INVALID_AUTHENTICATED_SUBJECT" }, "message": { "const": "The authenticated subject is invalid." }, "requestId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$" }, "retryable": { "const": false } }
        },
        "ROLE_FORBIDDEN": {
          "type": "object", "additionalProperties": false, "required": ["code", "message", "requestId", "retryable"],
          "properties": { "code": { "const": "ROLE_FORBIDDEN" }, "message": { "const": "The authenticated role is not permitted." }, "requestId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$" }, "retryable": { "const": false } }
        },
        "SESSION_EXPIRED": {
          "type": "object", "additionalProperties": false, "required": ["code", "message", "requestId", "retryable"],
          "properties": { "code": { "const": "SESSION_EXPIRED" }, "message": { "const": "The session has expired." }, "requestId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$" }, "retryable": { "const": false } }
        },
        "SESSION_REVOKED": {
          "type": "object", "additionalProperties": false, "required": ["code", "message", "requestId", "retryable"],
          "properties": { "code": { "const": "SESSION_REVOKED" }, "message": { "const": "The session is not active." }, "requestId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$" }, "retryable": { "const": false } }
        },
        "DEVICE_REVOKED": {
          "type": "object", "additionalProperties": false, "required": ["code", "message", "requestId", "retryable"],
          "properties": { "code": { "const": "DEVICE_REVOKED" }, "message": { "const": "The device is not authorized to synchronize." }, "requestId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$" }, "retryable": { "const": false } }
        },
        "CLAIM_IDENTITY_FAILED": {
          "type": "object", "additionalProperties": false, "required": ["code", "message", "requestId", "retryable"],
          "properties": { "code": { "const": "CLAIM_IDENTITY_FAILED" }, "message": { "const": "Please contact your doctor or clinic." }, "requestId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$" }, "retryable": { "const": false } }
        },
        "INTERNAL_ERROR": {
          "type": "object", "additionalProperties": false, "required": ["code", "message", "requestId", "retryable"],
          "properties": { "code": { "const": "INTERNAL_ERROR" }, "message": { "const": "The request could not be completed." }, "requestId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$" }, "retryable": { "const": true } }
        }
      }
    }
  }
}
