{
  "name": "@medsup/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/runtime.mjs",
    "./identity/subject": "./src/identity/subject.mjs",
    "./identity/session-manager": "./src/identity/session-manager.mjs",
    "./identity/errors": "./src/identity/errors.mjs",
    "./authorization/doctor-ownership": "./src/authorization/doctor-ownership.mjs",
    "./ingestion/ephemeral-document-gateway": "./src/ingestion/ephemeral-document-gateway.mjs",
    "./proposals/ocr-proposal-adapter": "./src/proposals/ocr-proposal-adapter.mjs",
    "./prescriptions/prescription-confirmation": "./src/prescriptions/prescription-confirmation.mjs",
    "./observability/structured-logger": "./src/observability/structured-logger.mjs"
  },
  "dependencies": {
    "@medsup/contracts": "1.0.0"
  },
  "scripts": {
    "build": "node ../../scripts/build-node-surface.mjs backend",
    "test": "node --test test/*.test.mjs",
    "lint": "node --check src/*.mjs src/authorization/*.mjs src/identity/*.mjs src/ingestion/*.mjs src/observability/*.mjs src/proposals/*.mjs src/prescriptions/*.mjs test/*.mjs test/support/*.mjs",
    "static-check": "node --test test/architecture.test.mjs"
  }
}
