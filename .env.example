# Safe local defaults only. Copy to .env; never commit real credentials.
MEDSUP_ENV=local
MEDSUP_LOG_LEVEL=info
MEDSUP_HTTP_HOST=127.0.0.1
MEDSUP_HTTP_PORT=3000

# Future adapters receive secrets through the runtime environment or a secret
# manager. Values below are deliberately empty and must never be exposed to a
# browser or mobile build.
MEDSUP_DATABASE_URL=
MEDSUP_IDENTITY_PROVIDER_URL=
MEDSUP_IDENTITY_CLIENT_SECRET=
MEDSUP_KMS_KEY_REFERENCE=
MEDSUP_OCR_PROVIDER_URL=
MEDSUP_OCR_API_KEY=
